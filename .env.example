# Copy to backend/.env and fill in ONE provider.

# Gemini (free tier works): https://aistudio.google.com/apikey
MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=

# Anthropic
# MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# OpenAI
# MODEL=openai:gpt-4.1-mini
# OPENAI_API_KEY=

# Policy
AUTO_APPROVE_LIMIT=50000
PRICE_TOLERANCE_PCT=1.0

# Demo: probability each mock ERP call fails transiently (0 to 1). Try 0.3.
FLAKY_RATE=0
